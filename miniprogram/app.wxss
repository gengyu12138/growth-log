/* 青绿色与纸白内容层；优先保证正文和控件可读。 */

page {
  --ink: #1c1c1e;
  --ink-2: #52695e;
  --ink-3: #5b7065;

  --glass: rgba(255, 255, 255, 0.58);
  --glass-soft: rgba(255, 255, 255, 0.42);
  --glass-strong: rgba(255, 255, 255, 0.82);
  --glass-line: #d7e4dc;
  --glass-line-2: #d7e4dc;

  --primary: #096f60;
  --primary-dim: #075c4f;
  --primary-soft: rgba(14, 145, 135, 0.12);
  --primary-line: rgba(14, 145, 135, 0.36);

  --amber: #b07a3c;
  --amber-soft: rgba(176, 122, 60, 0.13);

  --r-sm: 16rpx;
  --r-md: 24rpx;
  --r-lg: 34rpx;

  /* 保留既有页面的变量名，统一到青绿色主题。 */
  --paper: #eef5f5;
  --card: rgba(255, 255, 255, 0.55);
  --card-2: rgba(255, 255, 255, 0.45);
  --card-3: rgba(255, 255, 255, 0.34);
  --line: rgba(255, 255, 255, 0.52);
  --line-2: rgba(255, 255, 255, 0.6);
  --cinnabar: var(--primary);
  --cinnabar-dim: var(--primary-dim);
  --cinnabar-soft: var(--primary-soft);

  background: #eef5f5;
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

view, text, input, textarea, image, scroll-view, button {
  box-sizing: border-box;
}

.hidden { display: none !important; }

.muted { color: var(--ink-2); }

/* 页面内容要压在背景层之上 */
.page-root {
  position: relative;
  z-index: 1;
}

/* ── 排版 ─────────────────────────────────────────── */

.t-display {
  font-size: 54rpx;
  font-weight: 600;
  line-height: 1.22;
  letter-spacing: 2rpx;
}

.t-h2 {
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.4;
}

.t-small {
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--ink-2);
}

.t-micro {
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--ink-3);
}

.surface, .surface-lit, .surface-soft {
  background: #ffffff;
  border: 1rpx solid #dce7e2;
  border-radius: var(--r-lg);
  box-shadow: none;
}

/* ── 按钮 ─────────────────────────────────────────── */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 94rpx;
  padding: 0 34rpx;
  border: none;
  border-radius: var(--r-md);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1;
  margin: 0;
  transition: background-color 160ms ease, transform 160ms ease, opacity 160ms ease, box-shadow 160ms ease;
}

.btn::after { border: none; }

.btn-primary {
  background: #096f60;
  color: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(14, 145, 135, 0.3);
}

.btn-primary-hover {
  background: linear-gradient(180deg, #0f9a90 0%, #076e67 100%);
  transform: translateY(1rpx) scale(0.995);
  box-shadow: 0 6rpx 16rpx rgba(14, 145, 135, 0.24);
}

.btn-ghost {
  background: #f7faf8;
  color: var(--ink-2);
  border: 1rpx solid var(--glass-line);
  font-weight: 500;
}

.btn-ghost-hover {
  background: var(--glass);
}

.btn-text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  height: auto;
  background: transparent;
  border: none;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--primary);
  line-height: 1.4;
}

.btn-text::after { border: none; }

.btn[disabled] { opacity: 0.42; }

/* ── 输入 ─────────────────────────────────────────── */

.field-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink-3);
  letter-spacing: 1rpx;
  margin-bottom: 14rpx;
}

.field-input {
  width: 100%;
  height: 94rpx;
  padding: 0 26rpx;
  background: #f7faf8;
  border: 1rpx solid var(--glass-line);
  border-radius: var(--r-md);
  color: var(--ink);
  font-size: 30rpx;
  transition: border-color 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
}

.ph {
  color: #a1a1a6;
}

/* ── 反馈 ─────────────────────────────────────────── */

.msg-error {
  display: block;
  min-height: 36rpx;
  font-size: 24rpx;
  color: #d70015;
  line-height: 1.45;
  margin-top: 16rpx;
}

.divider {
  height: 1rpx;
  background: var(--glass-line-2);
  margin: 40rpx 0;
}

.rise, .rise-2, .rise-3 { animation: none; }

/* 月份翻页：整块侧向滑入 */
@keyframes flip-left {
  from {
    opacity: 0;
    transform: translateX(36rpx) scale(0.99);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@keyframes flip-right {
  from {
    opacity: 0;
    transform: translateX(-36rpx) scale(0.99);
  }
  to {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

.flip-left {
  animation: flip-left 340ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

.flip-right {
  animation: flip-right 340ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

/* 原生按钮默认宽度优先级较高，页面按钮显式遵循布局宽度。 */
page button.btn { width: 100%; max-width: none; }
page button.btn-text { width: auto; min-width: 0; }
.btn-text { min-height: 80rpx; }
.ph { color: #63766b; }
