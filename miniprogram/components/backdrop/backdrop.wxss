/* 毛玻璃底：渐变画布 + 六团缓慢漂移的光斑 + 一层极淡噪点 */
.backdrop {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
  background: linear-gradient(158deg, #e6f2f3 0%, #f3f9f7 46%, #ebf4f6 100%);
}

.blob {
  position: absolute;
  border-radius: 50%;
  will-change: transform;
}

/* 玫瑰：左上，最大的一团，慢慢呼吸 */
.b1 {
  width: 620rpx;
  height: 620rpx;
  top: -180rpx;
  left: -200rpx;
  background: radial-gradient(circle at 40% 40%, rgba(122, 208, 200, 0.52), rgba(122, 208, 200, 0) 68%);
  animation: float-a 26s ease-in-out infinite;
}

/* 天蓝：右上 */
.b2 {
  width: 560rpx;
  height: 560rpx;
  top: -120rpx;
  right: -180rpx;
  background: radial-gradient(circle at 50% 50%, rgba(132, 186, 232, 0.48), rgba(132, 186, 232, 0) 70%);
  animation: float-b 32s ease-in-out infinite;
}

/* 暖橙：中左 */
.b3 {
  width: 460rpx;
  height: 460rpx;
  top: 38%;
  left: -160rpx;
  background: radial-gradient(circle at 50% 50%, rgba(150, 214, 196, 0.42), rgba(150, 214, 196, 0) 70%);
  animation: float-c 29s ease-in-out infinite;
}

/* 紫：右下 */
.b4 {
  width: 520rpx;
  height: 520rpx;
  bottom: -140rpx;
  right: -160rpx;
  background: radial-gradient(circle at 50% 50%, rgba(160, 200, 224, 0.4), rgba(160, 200, 224, 0) 70%);
  animation: float-d 35s ease-in-out infinite;
}

/* 薄荷：左下 */
.b5 {
  width: 420rpx;
  height: 420rpx;
  bottom: 4%;
  left: -140rpx;
  background: radial-gradient(circle at 50% 50%, rgba(255, 206, 168, 0.32), rgba(255, 206, 168, 0) 70%);
  animation: float-b 24s ease-in-out infinite reverse;
}

/* 极淡的白：中心打光，让玻璃有东西可以折 */
.b6 {
  width: 900rpx;
  height: 900rpx;
  top: 18%;
  left: 50%;
  margin-left: -450rpx;
  background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0) 62%);
  animation: float-a 40s ease-in-out infinite reverse;
}

/* 磨砂颗粒：极细的斜线网，给玻璃一点手感的糙 */
.grain {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  opacity: 0.5;
  background-image:
    repeating-linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.5) 0,
      rgba(255, 255, 255, 0.5) 1rpx,
      transparent 1rpx,
      transparent 3rpx
    );
}

/* ── 浮尘 ─────────────────────────────────────────
   14 颗微小光点，各自以不同周期缓慢上浮下坠。
   用纯 CSS 的 transform + opacity，不产生重排。
   ────────────────────────────────────────────── */

.dust {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.mote {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.15) 70%);
  box-shadow: 0 0 12rpx rgba(255, 255, 255, 0.7);
  opacity: 0;
  animation-name: drift-up;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

.mote:nth-child(1)  { left: 6%;  top: 72%; animation-duration: 17s; animation-delay: 0s;    }
.mote:nth-child(2)  { left: 15%; top: 34%; animation-duration: 21s; animation-delay: -3s;   }
.mote:nth-child(3)  { left: 23%; top: 84%; animation-duration: 15s; animation-delay: -7s;   }
.mote:nth-child(4)  { left: 31%; top: 12%; animation-duration: 24s; animation-delay: -1s;   }
.mote:nth-child(5)  { left: 39%; top: 58%; animation-duration: 19s; animation-delay: -11s;  }
.mote:nth-child(6)  { left: 47%; top: 26%; animation-duration: 22s; animation-delay: -5s;   }
.mote:nth-child(7)  { left: 55%; top: 78%; animation-duration: 16s; animation-delay: -14s;  }
.mote:nth-child(8)  { left: 63%; top: 44%; animation-duration: 26s; animation-delay: -9s;   }
.mote:nth-child(9)  { left: 71%; top: 16%; animation-duration: 18s; animation-delay: -2s;   }
.mote:nth-child(10) { left: 79%; top: 66%; animation-duration: 23s; animation-delay: -6s;   }
.mote:nth-child(11) { left: 86%; top: 38%; animation-duration: 20s; animation-delay: -13s;  }
.mote:nth-child(12) { left: 93%; top: 88%; animation-duration: 15s; animation-delay: -4s;   }
.mote:nth-child(13) { left: 44%; top: 92%; animation-duration: 27s; animation-delay: -8s;   }
.mote:nth-child(14) { left: 68%; top: 6%;  animation-duration: 19s; animation-delay: -16s;  }

/* 登录页追加的 12 颗，填进前 14 颗的空隙 */
.mote:nth-child(15) { left: 10%; top: 18%; animation-duration: 23s; animation-delay: -10s;  }
.mote:nth-child(16) { left: 19%; top: 56%; animation-duration: 16s; animation-delay: -2s;   }
.mote:nth-child(17) { left: 27%; top: 28%; animation-duration: 25s; animation-delay: -15s;  }
.mote:nth-child(18) { left: 35%; top: 76%; animation-duration: 18s; animation-delay: -6s;   }
.mote:nth-child(19) { left: 42%; top: 42%; animation-duration: 21s; animation-delay: -12s;  }
.mote:nth-child(20) { left: 51%; top: 10%; animation-duration: 28s; animation-delay: -3s;   }
.mote:nth-child(21) { left: 58%; top: 62%; animation-duration: 17s; animation-delay: -18s;  }
.mote:nth-child(22) { left: 66%; top: 86%; animation-duration: 24s; animation-delay: -7s;   }
.mote:nth-child(23) { left: 74%; top: 30%; animation-duration: 20s; animation-delay: -13s;  }
.mote:nth-child(24) { left: 82%; top: 74%; animation-duration: 15s; animation-delay: -1s;   }
.mote:nth-child(25) { left: 89%; top: 20%; animation-duration: 26s; animation-delay: -9s;   }
.mote:nth-child(26) { left: 96%; top: 52%; animation-duration: 19s; animation-delay: -5s;   }

/* 第 2、5、9、12、16、20、23、26 颗小一号，避免节奏太齐 */
.mote:nth-child(2),
.mote:nth-child(5),
.mote:nth-child(9),
.mote:nth-child(12),
.mote:nth-child(16),
.mote:nth-child(20),
.mote:nth-child(23),
.mote:nth-child(26) {
  width: 5rpx;
  height: 5rpx;
  box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.55);
}

@keyframes drift-up {
  0% {
    opacity: 0;
    transform: translate3d(0, 0, 0) scale(0.6);
  }
  18% {
    opacity: 0.9;
  }
  50% {
    transform: translate3d(14rpx, -90rpx, 0) scale(1);
  }
  82% {
    opacity: 0.55;
  }
  100% {
    opacity: 0;
    transform: translate3d(-10rpx, -190rpx, 0) scale(0.7);
  }
}

@keyframes float-a {
  0%, 100% {
    transform: translate(0, 0) scale(1);
  }
  33% {
    transform: translate(70rpx, 50rpx) scale(1.08);
  }
  66% {
    transform: translate(-40rpx, 80rpx) scale(0.95);
  }
}

@keyframes float-b {
  0%, 100% {
    transform: translate(0, 0) scale(1);
  }
  40% {
    transform: translate(-80rpx, 60rpx) scale(1.1);
  }
  70% {
    transform: translate(30rpx, 110rpx) scale(0.94);
  }
}

@keyframes float-c {
  0%, 100% {
    transform: translate(0, 0) scale(1);
  }
  35% {
    transform: translate(90rpx, -50rpx) scale(1.06);
  }
  72% {
    transform: translate(40rpx, 40rpx) scale(0.97);
  }
}

@keyframes float-d {
  0%, 100% {
    transform: translate(0, 0) scale(1);
  }
  45% {
    transform: translate(-60rpx, -70rpx) scale(1.09);
  }
  75% {
    transform: translate(-20rpx, -20rpx) scale(0.96);
  }
}
