.insights{margin:16rpx 0;padding:18rpx;border:1rpx solid #d3e2d9;border-radius:16rpx;background:#f7faf8;color:#233d34}.heading,.hint,.label,.error,.warning{display:block}.heading{font-size:28rpx;font-weight:600}.hint{font-size:24rpx;line-height:1.6;color:#52695e;margin:8rpx 0}.insight+.insight{border-top:1rpx solid #dce7e2;margin-top:16rpx;padding-top:16rpx}.head{display:flex;align-items:center;gap:12rpx;font-size:25rpx}.head image{width:68rpx;height:68rpx;flex:none;border-radius:10rpx;background:#e4ede7}.head text{flex:1}.insights button{margin:0;min-height:70rpx;padding:10rpx 14rpx;line-height:1.5;font-size:25rpx;border:0;background:transparent;color:#096f60;width:auto}.insights button::after{border:0}.insights button[disabled]{opacity:.45}.label{font-size:24rpx;color:#52695e;margin-top:16rpx}.insights textarea{box-sizing:border-box;width:100%;margin:10rpx 0;padding:14rpx;font-size:27rpx;line-height:1.65;color:#233d34;background:#fff;border:1rpx solid #d3e2d9;border-radius:12rpx}.caption{height:138rpx}.recognized-text{height:220rpx}.error,.warning{font-size:24rpx;line-height:1.6;margin:12rpx 0;color:#8b481f}.actions{display:flex;justify-content:space-between;gap:12rpx;flex-wrap:wrap}.insights button.apply{background:#096f60;color:#fff;border-radius:12rpx;padding:14rpx 20rpx}
