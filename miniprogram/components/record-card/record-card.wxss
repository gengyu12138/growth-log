.record {
  background:#fff;
  border:1rpx solid #dce7e2;
  border-radius:24rpx;
  padding:28rpx;
  margin-bottom:22rpx;
  color:#233d34;
  overflow-wrap:anywhere
}


.record-head,.record-foot {
  display:flex;
  align-items:center;
  gap:14rpx;
  flex-wrap:wrap
}

.record-head {
  margin-bottom:18rpx
}

.type {
  font-size:25rpx;
  font-weight:600;
  color:#176d5d
}

.time {
  font-size:24rpx;
  color:#52695e;
  margin-left:auto
}

.more {
  margin:0;
  padding:0;
  width:88rpx;
  min-height:70rpx;
  background:transparent;
  font-size:30rpx;
  color:#52695e;
  line-height:2
}

.more::after,.link::after {
  border:0
}


.title {
  display:block;
  font-size:36rpx;
  font-weight:600;
  line-height:1.5;
  margin-bottom:20rpx
}

.body {
  display:block;
  font-size:31rpx;
  line-height:1.75;
  white-space:pre-wrap
}

.layout-milestone {
  border-top:6rpx solid #a56d2d;
  background:#fffcf5
}

.layout-milestone .type {
  color:#83591f
}

.layout-milestone .body {
  font-size:33rpx
}

.layout-health {
  border-left:6rpx solid #ad6570;
  background:#fffafb
}

.layout-health .type {
  color:#964454
}

.layout-interval {
  background:#f4f8ff;
  border-top:4rpx solid #758fbb
}

.layout-interval .type {
  color:#48648b
}

.layout-metrics {
  border-top:4rpx solid #378574
}

.layout-photo {
  padding:24rpx
}

.planned {
  border-style:dashed
}


.metrics {
  display:flex;
  flex-wrap:wrap;
  gap:24rpx;
  margin:12rpx 0 24rpx
}

.metric {
  flex:1;
  min-width:170rpx;
  max-width:100%
}

.metric.featured {
  flex-basis:100%
}

.featured .value {
  font-size:54rpx
}

.label {
  display:block;
  font-size:25rpx;
  color:#52695e;
  margin-bottom:6rpx
}

.value {
  font-size:40rpx;
  font-weight:600;
  line-height:1.3
}

.unit {
  font-size:25rpx;
  margin-left:8rpx
}

.manual {
  display:block;
  font-size:23rpx;
  color:#52695e
}

.interval {
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:10rpx;
  font-size:27rpx;
  margin:12rpx 0 20rpx
}

.interval-to {
  color:#52695e
}


.facts {
  margin-top:20rpx
}

.fact {
  display:flex;
  justify-content:space-between;
  gap:24rpx;
  padding:14rpx 0;
  border-bottom:1rpx solid #e6eee9;
  font-size:28rpx
}

.fact .label {
  flex:none;
  max-width:45%
}

.photos {
  display:flex;
  flex-wrap:wrap;
  gap:10rpx;
  margin:24rpx 0
}

.photos image {
  width:calc((100% - 20rpx)/3);
  height:175rpx;
  border-radius:16rpx;
  background:#edf3ef
}

.photos.single image {
  width:100%;
  height:370rpx
}

.note {
  display:block;
  font-size:27rpx;
  color:#52695e;
  margin-top:20rpx;
  white-space:pre-wrap
}

.record-foot {
  font-size:24rpx;
  color:#52695e;
  margin-top:20rpx;
  justify-content:space-between
}

.link {
  display:inline-flex;
  align-items:center;
  min-height:70rpx;
  margin:0;
  padding:8rpx 0;
  background:transparent;
  font-size:25rpx;
  color:#176d5d;
  line-height:1.4
}

.saved {
  display:block;
  color:#52695e;
  font-size:24rpx;
  margin-top:12rpx
}



.record button.more {
  flex:0 0 88rpx;
  width:88rpx;
  min-width:0;
  max-width:88rpx;
  margin:0
}

.record button.link {
  width:auto;
  min-width:0;
  margin:0
}

.tags {
  display:flex;
  flex-wrap:wrap;
  gap:10rpx;
  margin-top:14rpx
}

.record button.tag {
  width:auto;
  min-width:0;
  min-height:66rpx;
  font-size:24rpx;
  line-height:1.4;
  padding:10rpx 14rpx;
  margin:0;
  background:#edf5ef;
  color:#176d5d;
  border-radius:10rpx
}

.tag::after {
  border:0
}
