.smart-card { margin: 12rpx 0; padding: 18rpx; border-radius: 18rpx; background: rgba(14,145,135,.06); color: var(--ink, #183b38); }
.head, .value-row, .related { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.head { justify-content: space-between; margin-bottom: 12rpx; }
.type { font-size: 25rpx; font-weight: 600; }
.source-link { color: var(--primary, #0e9187); font-size: 26rpx; }
.fields { display: flex; flex-wrap: wrap; gap: 16rpx; }
.field { min-width: 160rpx; max-width: 100%; flex: 1; }
.label, .hint, .evidence { display: block; font-size: 25rpx; color: var(--ink-2, #59716e); line-height: 1.6; }
.value { font-size: 30rpx; font-weight: 600; overflow-wrap: break-word; }
.unit, .remove { font-size: 25rpx; }
.remove { color: var(--ink-2, #59716e); padding: 10rpx 0; }
input { min-width: 100rpx; width: 150rpx; font-size: 27rpx; border-bottom: 1rpx solid rgba(14,145,135,.25); }
.related { margin-top: 12rpx; }
