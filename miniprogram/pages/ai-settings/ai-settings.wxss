.page { position: relative; z-index: 1; padding: 20rpx 32rpx calc(80rpx + env(safe-area-inset-bottom)); }
.rule-intro, .rule-editor, .rule-history { padding: 28rpx; margin-bottom: 24rpx; }
.description { display: block; margin: 18rpx 0; font-size: 25rpx; line-height: 1.7; color: var(--ink-2); }
.rule-intro .t-micro { display: block; line-height: 1.7; }
.rule-picker { display: flex; align-items: center; margin-top: 22rpx; }
.rule-text { width: 100%; height: 440rpx; box-sizing: border-box; padding: 20rpx; background: var(--card-3); border: 1rpx solid var(--line); border-radius: var(--r-sm); font-size: 27rpx; line-height: 1.7; color: var(--ink); }
.editor-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; margin: 16rpx 0 24rpx; }
.status { display: block; margin: 24rpx 0; color: var(--ink-3); }
.reload { margin: 16rpx auto 32rpx; }
.version { display: block; margin: 12rpx 0; }
