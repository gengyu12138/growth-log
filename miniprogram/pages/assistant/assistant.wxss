@import '../growth/growth.wxss';
.request { height: 190rpx; padding: 20rpx; margin-top: 20rpx; }
.answer { height: 130rpx; padding: 20rpx; margin: 20rpx 0; }
.saved-row { display: flex; justify-content: space-between; gap: 24rpx; margin-top: 24rpx; }
.saved-row .btn-text { width: auto; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 18rpx 0; }
.chip { background: var(--primary-soft); color: var(--primary-dim); padding: 6rpx 12rpx; border-radius: 12rpx; font-size: 24rpx; }
.candidate { margin-top: 28rpx; padding: 18rpx; border: 2rpx solid var(--line); border-radius: 18rpx; }
.candidate.selected { border-color: var(--primary); }
.trend-row { display: flex; align-items: center; gap: 16rpx; margin: 12rpx 0; font-size: 23rpx; }
.trend-track { flex: 1; height: 14rpx; background: var(--primary-soft); border-radius: 7rpx; }
.trend-bar { height: 100%; background: var(--primary); border-radius: 7rpx; }
