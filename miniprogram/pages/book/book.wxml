<backdrop /><navbar title="制作成长册" back />
<view class="workspace"><text class="error">{{error}}</text><text class="muted">{{status}}</text><button wx:if="{{error && !busy}}" class="btn-text" bindtap="load">重新读取记录</button>
  <view class="surface panel"><text class="heading">选一段成长时光</text><view class="row"><button class="btn-text" disabled="{{busy}}" bindtap="thisYear">本年</button><button class="btn-text" disabled="{{busy}}" bindtap="birthday">按最近一个生日年</button></view><view class="row"><picker mode="date" value="{{start}}" disabled="{{busy}}" data-field="start" bindchange="onDate">开始 {{start}}</picker><picker mode="date" value="{{end}}" disabled="{{busy}}" data-field="end" bindchange="onDate">结束 {{end}}</picker></view><button wx:if="{{rangeChanged}}" class="btn-text" disabled="{{busy}}" bindtap="applyRange">应用这个日期范围</button>
    <text class="muted">只纳入已发生记录。选择 {{selectedCount}} / {{recordCount}} 条；照片 {{selectedPhotoCount}} 张。</text>
    <view class="row"><button class="btn-text" disabled="{{busy}}" bindtap="toggleRecords">{{pickingRecords ? '收起记录选择' : '逐条选取记录'}}</button><button class="btn-text" disabled="{{busy}}" bindtap="selectAll">全选</button><button class="btn-text" disabled="{{busy}}" bindtap="selectHighlights">只选第一次与珍藏</button></view>
    <scroll-view wx:if="{{pickingRecords}}" scroll-y class="record-select"><checkbox-group bindchange="onRecords"><label wx:for="{{choices}}" wx:key="_id" class="check-row"><checkbox value="{{item._id}}" checked="{{item.checked}}" disabled="{{busy}}" color="#096f60" /><view class="body"><text class="muted">{{item.happened_on}}</text>{{item.content || '照片记录'}}</view></label></checkbox-group></scroll-view>
    <text wx:if="{{missingCount}}" class="error">草稿中 {{missingCount}} 条记录已删除或不在当前日期范围，本次不会导出；原选取仍保留在本机草稿中。</text>
  </view>
  <view class="surface panel"><text class="heading">封面与寄语</text><input class="field-input" value="{{title}}" maxlength="60" disabled="{{busy}}" data-field="title" bindinput="onInput" placeholder="成长册标题" /><input class="field-input" value="{{subtitle}}" maxlength="100" disabled="{{busy}}" data-field="subtitle" bindinput="onInput" placeholder="副标题，可留空" /><textarea class="field-input parent-message" value="{{message}}" maxlength="1000" disabled="{{busy}}" data-field="message" bindinput="onInput" placeholder="写给宝宝的话，或一家人的年度寄语" /><text class="muted">{{message.length}} / 1000 · 修改只影响成长册，不改原记录</text>
    <image wx:if="{{coverId}}" class="book-cover" src="{{coverId}}" mode="aspectFit" /><button wx:if="{{coverId}}" class="btn-text" disabled="{{busy}}" bindtap="clearCover">不设封面照片</button>
    <button class="btn-text" disabled="{{busy}}" bindtap="togglePhotos">{{pickingPhotos ? '收起照片选择' : '选照片与封面'}} · {{selectedPhotoCount}} 张</button><checkbox-group wx:if="{{pickingPhotos}}" bindchange="onPhotos"><view class="thumbs"><label wx:for="{{photos}}" wx:key="id" class="photo-option"><image src="{{item.id}}" mode="aspectFill" lazy-load /><checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{busy}}" color="#096f60" /><button class="btn-text" data-id="{{item.id}}" disabled="{{busy}}" catchtap="setCover">{{coverId === item.id ? '已设封面' : '设为封面'}}</button></label></view></checkbox-group>
  </view>
  <view wx:for="{{chapters}}" wx:key="month" class="surface panel"><text class="muted">{{item.month}} · {{item.count}} 条记录</text><input class="field-input" value="{{item.title}}" maxlength="50" disabled="{{busy}}" data-month="{{item.month}}" data-field="title" bindinput="onChapter" /><textarea class="field-input chapter-note" value="{{item.note}}" maxlength="200" disabled="{{busy}}" data-month="{{item.month}}" data-field="note" bindinput="onChapter" placeholder="为这一章写几句话，可留空" /></view>
  <view class="surface panel"><view class="row"><text>文件包含所选照片（ZIP）</text><switch checked="{{withPhotos}}" disabled="{{busy}}" bindchange="onWithPhotos" color="#096f60" /></view><text class="muted">{{withPhotos ? '生成ZIP，解压后打开 growth-book.html；同时保留所选记录与照片文件。单包最多80MB。' : '生成文字版HTML，可用浏览器阅读和打印；需要封面与照片时打开上方开关。'}}</text><button class="btn btn-primary" disabled="{{busy || loading || !selectedCount || rangeChanged}}" bindtap="exportBook">{{busy ? '正在制作…' : '生成成长册文件'}}</button><button wx:if="{{busy}}" class="btn-text" bindtap="cancelExport">取消制作</button><text class="muted">{{exportStatus}}</text><button wx:if="{{exportPath}}" class="btn btn-ghost" disabled="{{busy}}" bindtap="share">保存或发送已生成文件</button><button class="btn-text" bindtap="togglePreview">{{preview ? '收起内容预览' : '查看内容预览'}}</button></view>
  <view wx:if="{{preview}}" class="book-preview"><text class="heading">{{title}}</text><text class="muted">{{subtitle}}</text><text wx:if="{{message}}" class="body">{{message}}</text><view wx:for="{{previewChapters}}" wx:key="month" class="rule"><text class="heading">{{item.title}}</text><text class="body">{{item.note}}</text><view wx:for="{{item.entries}}" wx:for-item="entry" wx:key="_id"><text class="muted">{{entry.happened_on}}</text><text class="body">{{entry.content || '照片记录'}}</text></view><text wx:if="{{item.count > 3}}" class="muted">此处预览前3条，导出含本章所选 {{item.count}} 条。</text></view></view>
</view>
