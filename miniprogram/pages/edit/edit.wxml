<backdrop />
<navbar title="{{readOnly ? '记录原文' : '编辑记录'}}" back />
<view class="page page-root">
  <text wx:if="{{loading}}" class="t-small">正在读取记录…</text>
  <view wx:if="{{!loading && entryLoaded}}" class="surface form">
    <text wx:if="{{sourceWarning}}" class="msg-error">{{sourceWarning}}</text>
    <smart-card card="{{card}}" editable="{{canEdit && cardsSupported}}" disabled="{{busy}}" bind:fieldchange="onCardField" bind:unlink="onCardUnlink" />
    <button wx:if="{{canEdit && cardsSupported && card}}" class="btn-text" disabled="{{busy}}" bindtap="onRemoveCard">移除卡片，保留原文</button>
    <text wx:if="{{canEdit && card}}" class="t-micro">修改正文或发生日期/时间会清除旧卡片，避免统计继续使用过期信息。</text>
    <text class="field-label">记录日期</text>
    <picker mode="date" value="{{date}}" disabled="{{busy || !canEdit}}" bindchange="onDate"><view class="field-input picker">{{date}}</view></picker>
    <block wx:if="{{smartSupported}}">
      <text class="field-label">事件时间{{canEdit ? ' · 手动修改后以此为准' : ''}}</text>
      <picker mode="time" value="{{at || '08:00'}}" disabled="{{busy || !canEdit}}" bindchange="onTime"><view class="field-input picker">{{at || '原记录保存时间'}}</view></picker>
      <text class="field-label">尚未发生的计划{{canEdit ? '（完成后可关闭）' : ''}}</text>
      <switch checked="{{planned}}" disabled="{{busy || !canEdit}}" bindchange="onPlanned" color="#0e9187" />
    </block>
    <text class="field-label">分类</text>
    <picker range="{{kinds}}" value="{{kindIndex}}" disabled="{{busy || !canEdit}}" bindchange="onKind"><view class="field-input picker">{{kinds[kindIndex]}}</view></picker>
    <text class="field-label">记录正文 · 最多 500 字</text>
    <textarea class="field-input body" value="{{content}}" maxlength="-1" disabled="{{busy || !canEdit}}" bindinput="onContent" />
    <text wx:if="{{content.length >= 450}}" class="t-micro">{{content.length}} / 500{{content.length > 500 ? ' · 已保留全部原文，请缩短' : ''}}</text>
    <text class="field-label">备注 · 最多 200 字</text>
    <textarea class="field-input note" value="{{note}}" maxlength="200" disabled="{{busy || !canEdit}}" bindinput="onNote" />
    <view wx:if="{{images.length}}" class="images"><image wx:for="{{images}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="onPreview" /></view>
    <text wx:if="{{canEdit}}" class="t-micro">原有图片保留。保存时会检查是否有家人更新了这条记录。</text>
    <button wx:if="{{canEdit}}" class="btn btn-primary" disabled="{{busy || conflict}}" bindtap="onSave">{{busy ? '保存中…' : '保存修改'}}</button>
  </view>
  <text wx:if="{{!loading && !canEdit && !readOnly && !error}}" class="t-small">只读成员不能编辑记录。</text>
  <text class="msg-error" selectable>{{error}}</text>
  <button wx:if="{{conflict}}" class="btn-text" bindtap="reloadLatest">重新读取最新记录</button>
  <button wx:elif="{{error && !canEdit}}" class="btn-text" bindtap="load">重试</button>
</view>
