<template name="entryCard">
  <record-card entry="{{item}}" can-edit="{{canEdit}}" data-id="{{item._id}}" bind:menu="onEntryMenu" />
  <button wx:if="{{item.aiLabel}}" class="btn-text" data-id="{{item._id}}" bindtap="onRetryTag">{{item.aiLabel}}</button>
</template>

<backdrop />
<view class="navbar" style="padding-top:{{statusBar}}px;">
  <view class="bar" style="height:{{barHeight}}px;">
    <view class="month-nav">
      <view wx:if="{{viewMode === 'calendar'}}" class="arrow" bindtap="prevMonth" hover-class="arrow-hover">‹</view>
      <text class="month">{{viewMode === 'calendar' ? monthTitle : '成长记录'}}</text>
      <view wx:if="{{viewMode === 'calendar'}}" class="arrow" bindtap="nextMonth" hover-class="arrow-hover">›</view>
    </view>
  </view>
</view>

<view style="height:{{navTotal}}px;"></view>

<view class="root" style="height: calc(100vh - {{navTotal}}px);">
<scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
<view class="page">

  <view class="baby-row" bindtap="goMembers">{{babyLabel || '宝宝档案'}}</view>
  <text wx:if="{{profileError}}" class="t-micro" bindtap="retryProfile">{{profileError}}</text>
  <button class="home-search" bindtap="goSearch">搜索成长瞬间，例如：奶、走路、第一次</button>
  <view class="quick-links"><button class="btn-text" bindtap="goPhotos">照片回忆</button><button class="btn-text" bindtap="goLibrary">珍藏的时刻</button><button class="btn-text" bindtap="togglePlans">{{showPlans ? '返回成长记录' : '待办计划'}}</button></view>

  <view class="head-row rise">
    <text class="stats">{{stats}}</text>
    <view class="view-switch">
      <view class="seg {{viewMode === 'calendar' ? 'on' : ''}}" data-mode="calendar" bindtap="onSwitchView">日历</view>
      <view class="seg {{viewMode === 'timeline' ? 'on' : ''}}" data-mode="timeline" bindtap="onSwitchView">时间轴</view>
    </view>
  </view>

  <block wx:if="{{viewMode === 'calendar'}}">
    <view class="calendar surface-lit {{monthAnim}}">
      <view class="weekdays">
        <text class="weekday">一</text>
        <text class="weekday">二</text>
        <text class="weekday">三</text>
        <text class="weekday">四</text>
        <text class="weekday">五</text>
        <text class="weekday">六</text>
        <text class="weekday">日</text>
      </view>

      <view class="grid">
        <view
          wx:for="{{cells}}"
          wx:key="index"
          class="cell {{item ? '' : 'blank'}} {{item && item.date === selectedDate ? 'sel' : ''}} {{item && item.date === today ? 'is-today' : ''}}"
          data-date="{{item ? item.date : ''}}"
          bindtap="onPickDay"
        >
          <view class="cell-inner">
            <text wx:if="{{item}}" class="cell-day">{{item.day}}</text>
            <view wx:if="{{item && item.count}}" class="dot"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="day-head rise-2">
      <text class="day-label">{{dayLabel}}</text>
      <text class="day-count">{{dayCountText}}</text><button class="btn-text" bindtap="goToday">今天</button><button wx:if="{{canEdit}}" class="btn-text" data-date="{{selectedDate}}" bindtap="openComposer">补记这一天</button>
    </view>

    <view wx:if="{{!dayEntries.length && !loading && !loadError}}" class="empty rise-2">
      <view class="empty-mark"></view>
      <text class="empty-text">这一天还没有记录</text>
    </view>

    <view class="entry-list">
      <block wx:for="{{dayEntries}}" wx:key="_id">
        <template is="entryCard" data="{{item: item, idx: index, canEdit: canEdit, compact: false}}" />
      </block>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{!timeline.length && !loading && !loadError}}" class="empty rise-2">
      <view class="empty-mark"></view>
      <text class="empty-text">{{showPlans ? '当前读取范围没有待办计划' : '当前读取范围还没有成长记录'}}</text>
    </view>

    <view wx:for="{{timeline}}" wx:key="date" wx:for-item="group" class="tl-group">
      <view class="tl-date">
        <text class="tl-label">{{group.label}}</text>
        <text class="tl-count">{{group.entries.length}} 条</text>
      </view>

      <view class="tl-body">
        <block wx:for="{{group.entries}}" wx:key="_id" wx:for-item="entry">
          <template is="entryCard" data="{{item: entry, canEdit: canEdit}}" />
        </block>
      </view>
    </view>
  </block>

  <view class="load-status">
    <text wx:if="{{loading}}">正在读取记录…</text>
    <block wx:elif="{{loadError}}">
      <text>{{loadError}}</text>
      <button class="btn-text" bindtap="onRetry">重试</button>
    </block>
    <button wx:elif="{{hasMore}}" class="btn-text" bindtap="onLoadMore">加载更早记录</button>
  </view>
  <view class="bottom-space"></view>
</view>
</scroll-view>

<view wx:if="{{(canEdit || savePending) && composerOpen}}" class="composer">
  <view class="compose-head"><text>记下一个瞬间</text><button class="btn-text" disabled="{{busy || savePending || recording || transcribing || voiceStarting}}" bindtap="closeComposer">收起，保留草稿</button></view>
  <text wx:if="{{savePending}}" class="t-micro">上次保存结果待确认，请重试保存后继续编辑</text>
  <view class="draft-info">
    <picker wx:if="{{analysisEvents.length < 2}}" mode="date" value="{{draftDate || selectedDate}}" disabled="{{busy || savePending || recording || transcribing || voiceStarting}}" bindchange="onDraftDate">记录日期：{{draftDate || selectedDate}}</picker>
    <text wx:if="{{draftStatus && !savePending}}" class="t-micro">{{draftStatus}}</text>
    <button wx:if="{{(text || images.length) && !savePending}}" class="btn-text" disabled="{{busy || recording || transcribing || voiceStarting}}" bindtap="discardDraft">清除草稿</button>
  </view>
  <button class="btn-text" bindtap="toggleAdvanced">{{advanced ? '收起时间、分类与计划' : '时间、分类与计划'}}</button>
  <view wx:if="{{advanced && analysisEvents.length < 2}}" class="draft-info">
    <picker mode="time" value="{{draftAt || '08:00'}}" disabled="{{busy || savePending || recording || transcribing || voiceStarting}}" bindchange="onDraftTime">时间：{{draftAt || '保存时的当前时间'}}{{timeManual ? ' · 手动' : ''}}</picker>
    <button wx:if="{{draftAt}}" class="btn-text" disabled="{{busy || savePending || recording || transcribing || voiceStarting}}" bindtap="onUseCurrentTime">用当前时间</button>
    <text>计划</text><switch checked="{{planned}}" disabled="{{busy || savePending || recording || transcribing || voiceStarting}}" bindchange="onPlanned" color="#0e9187" />
  </view>
  <view wx:if="{{recognitionStatus && !savePending}}" class="recognition">
    <text>{{recognitionStatus}}</text><button wx:if="{{!recognizing}}" class="btn-text" disabled="{{busy}}" bindtap="retryRecognition">重新识别</button>
    <button wx:if="{{assistantIntent}}" class="btn-text" disabled="{{busy}}" bindtap="goAssistant">打开智能助手</button>
    <text wx:if="{{recognitionWarning}}" class="recognition-warning">{{recognitionWarning}}</text>
  </view>
  <view wx:if="{{analysisEvents.length === 1 && analysisEvents[0].card && !savePending}}" class="card-preview">
    <record-card entry="{{analysisEvents[0]}}" reading preview />
    <button class="btn-text" data-index="0" bindtap="toggleCardEditor">{{editingCardIndex === 0 ? '收起字段调整' : '调整卡片字段与依据'}}</button>
    <smart-card wx:if="{{editingCardIndex === 0}}" card="{{analysisEvents[0].card}}" editable changeable-type disabled="{{busy}}" data-index="0" bind:typechange="onCardType" bind:fieldchange="onCardField" bind:unlink="onCardUnlink" />
    <button class="btn-text" data-index="0" disabled="{{busy}}" bindtap="onRemoveCard">仅保留原文</button>
  </view>
  <text wx:if="{{newTypes.length && !savePending}}" class="t-micro">新类型：{{newTypesLabel}} · 保存时确认，之后自动复用</text>
  <scroll-view wx:if="{{analysisEvents.length > 1 && !savePending}}" scroll-y class="proposals">
    <view wx:for="{{analysisEvents}}" wx:key="index" class="proposal">
      <text>{{index + 1}}. {{item.content}}</text>
      <record-card entry="{{item}}" reading preview />
      <button wx:if="{{item.card}}" class="btn-text" data-index="{{index}}" bindtap="toggleCardEditor">{{editingCardIndex === index ? '收起字段调整' : '调整卡片字段与依据'}}</button>
      <smart-card wx:if="{{editingCardIndex === index}}" card="{{item.card}}" editable changeable-type disabled="{{busy}}" data-index="{{index}}" bind:typechange="onCardType" bind:fieldchange="onCardField" bind:unlink="onCardUnlink" />
      <button wx:if="{{item.card}}" class="btn-text" data-index="{{index}}" disabled="{{busy}}" bindtap="onRemoveCard">仅保留原文</button>
      <view class="draft-info">
        <picker mode="date" value="{{item.date}}" data-index="{{index}}" data-field="date" disabled="{{busy}}" bindchange="onProposal">{{item.date}}</picker>
        <picker mode="time" value="{{item.at || '08:00'}}" data-index="{{index}}" data-field="at" disabled="{{busy}}" bindchange="onProposal">{{item.at || '当前时间'}}</picker>
        <button wx:if="{{item.at}}" size="mini" class="btn-text" data-index="{{index}}" disabled="{{busy}}" bindtap="clearProposalTime">用当前时间</button>
        <text>计划</text><switch checked="{{item.planned}}" data-index="{{index}}" data-field="planned" disabled="{{busy}}" bindchange="onProposal" color="#0e9187" />
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{advanced}}" class="kinds">
    <view
      wx:for="{{kinds}}"
      wx:key="key"
      class="kind {{kind === item.key ? 'active' : ''}}"
      data-kind="{{item.key}}"
      bindtap="onKind"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{images.length}}" class="pending">
    <view wx:for="{{images}}" wx:key="*this" class="pending-item">
      <image class="pending-img" src="{{item}}" mode="aspectFill" />
      <view class="pending-x" data-index="{{index}}" bindtap="onRemoveImage">×</view>
    </view>
  </view>

  <view class="voice-row">
    <button wx:if="{{!recording}}" class="btn-text" disabled="{{busy || savePending || transcribing || voiceStarting}}" bindtap="startVoice">{{transcribing ? '正在转文字…' : '语音记一条'}}</button>
    <button wx:if="{{recording}}" class="btn-text" bindtap="stopVoice">说完了，转文字</button><button wx:if="{{recording}}" class="btn-text" bindtap="cancelVoice">取消录音</button>
    <button wx:if="{{voiceRetry && !transcribing}}" class="btn-text" disabled="{{busy || savePending || recording || voiceStarting}}" bindtap="retryVoice">重试转文字</button>
  </view><text wx:if="{{voiceStatus}}" class="voice-status">{{voiceStatus}}</text>
  <text wx:if="{{text.length >= 450}}" class="char-count {{text.length > 500 ? 'recognition-warning' : ''}}">{{text.length}} / 500{{text.length > 500 ? ' · 已保留全部原文，请缩短后保存' : ' · 接近字数上限'}}</text>
  <view class="composer-row">
    <textarea
      class="composer-input"
      value="{{text}}"
      disabled="{{busy || savePending || recording || transcribing || voiceStarting}}"
      bindinput="onText"
      bindfocus="onKbFocus"
      bindblur="onKbBlur"
      adjust-position="{{true}}"
      bindkeyboardheightchange="onKbHeight"
      cursor-spacing="24"
      auto-height
      maxlength="-1"
      placeholder="用自己的话，记下这个瞬间…"
      placeholder-class="ph"
    />
    <view class="pic-btn" bindtap="onPickImage" hover-class="pic-btn-hover">
      <text class="pic-btn-text">照片</text>
    </view>
    <view class="send-btn {{busy || text.length > 500 ? 'off' : ''}}" bindtap="onSave" hover-class="send-btn-hover">{{savePending ? (saveRetrySafe ? '重试保存' : '核对保存') : (analysisEvents.length > 1 ? '确认拆分' : '记下')}}</view>
  </view>
</view>

<view wx:if="{{canEdit && !composerOpen}}" class="compose-launch"><button class="btn btn-primary" disabled="{{busy}}" bindtap="openComposer">{{composerOpen ? '继续记录' : text || images.length ? '继续未完成的草稿' : '＋ 记下一个瞬间'}}</button></view>
<app-tabs active="records" flow disabled="{{busy || savePending || recording || transcribing || voiceStarting}}" />
</view>
