.root {
  display:flex;
  flex-direction:column;
  position:relative;
  z-index:1;
  overflow:hidden;
  padding-bottom:calc(100rpx + env(safe-area-inset-bottom))
}

.scroll {
  flex:1;
  height:0
}

.page {
  padding:12rpx 28rpx
}

.navbar {
  position:fixed;
  inset:0 0 auto;
  z-index:20;
  background:#f1f7f4
}

.bar {
  display:flex;
  align-items:center;
  padding:0 24rpx
}

.month-nav {
  display:flex;
  align-items:center
}

.arrow {
  width:88rpx;
  height:88rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:38rpx;
  color:var(--ink-2)
}

.month {
  font-size:34rpx;
  font-weight:600
}

.baby-row {
  font-size:28rpx;
  color:var(--primary);
  margin:12rpx 0 20rpx
}

.home-search {
  width:100%;
  text-align:left;
  margin:8rpx 0 18rpx;
  padding:22rpx 26rpx;
  background:#fff;
  border:1rpx solid #d7e4dc;
  border-radius:20rpx;
  font-size:27rpx;
  color:var(--ink-2);
  line-height:1.5
}

.home-search::after {
  border:0
}

.quick-links {
  display:flex;
  justify-content:space-between;
  gap:18rpx;
  margin-bottom:24rpx
}

.head-row {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20rpx;
  padding-bottom:24rpx
}

.stats,.day-count {
  font-size:25rpx;
  color:var(--ink-2)
}

.view-switch {
  display:flex;
  border-radius:16rpx;
  background:#e5eee8;
  padding:4rpx
}

.seg {
  padding:16rpx 22rpx;
  font-size:25rpx;
  color:var(--ink-2);
  border-radius:14rpx
}

.seg.on {
  background:var(--primary);
  color:#fff
}

.calendar {
  padding:18rpx 8rpx
}

.weekdays,.grid {
  display:flex;
  flex-wrap:wrap
}

.weekday {
  width:14.28%;
  text-align:center;
  font-size:25rpx;
  color:var(--ink-2);
  padding:8rpx 0
}

.cell {
  width:14.28%;
  height:82rpx;
  display:flex;
  align-items:center;
  justify-content:center
}

.cell.blank {
  visibility:hidden
}

.cell-inner {
  width:66rpx;
  height:66rpx;
  border-radius:16rpx;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center
}

.cell-day {
  font-size:29rpx;
  line-height:1.2
}

.dot {
  width:7rpx;
  height:7rpx;
  border-radius:50%;
  background:var(--primary);
  margin-top:5rpx
}

.cell.is-today .cell-inner {
  border:1rpx solid var(--primary)
}

.cell.sel .cell-inner {
  background:var(--primary);
  color:#fff
}

.cell.sel .dot {
  background:#fff
}

.day-head {
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:16rpx;
  padding:26rpx 0 20rpx
}

.day-label {
  font-size:29rpx;
  font-weight:600
}

.tl-date {
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:20rpx 2rpx 18rpx
}

.tl-label {
  font-size:29rpx;
  font-weight:600
}

.tl-count {
  font-size:25rpx;
  color:var(--ink-2)
}

.tl-group {
  margin-bottom:18rpx
}

.empty {
  padding:90rpx 12rpx;
  text-align:center
}

.empty-text {
  font-size:28rpx;
  color:var(--ink-2)
}

.load-status {
  text-align:center;
  padding:24rpx 0;
  color:var(--ink-2);
  font-size:27rpx
}

.bottom-space {
  height:24rpx
}


.composer {
  flex:none;
  padding:20rpx 28rpx;
  max-height:65vh;
  overflow-y:auto;
  background:#fff;
  border-top:1rpx solid #d7e4dc
}



.draft-info {
  display:flex;
  align-items:center;
  gap:14rpx;
  flex-wrap:wrap;
  margin-bottom:14rpx;
  font-size:26rpx;
  color:var(--ink-2)
}

.composer-row {
  display:flex;
  align-items:flex-end;
  gap:12rpx;
  margin-top:18rpx
}

.composer-input {
  flex:1;
  min-height:100rpx;
  max-height:200rpx;
  padding:18rpx;
  background:#f1f7f4;
  border:1rpx solid #cdded3;
  border-radius:18rpx;
  font-size:31rpx;
  line-height:1.6
}

.pic-btn {
  display:flex;
  justify-content:center;
  align-items:center;
  min-width:88rpx;
  height:88rpx;
  border:1rpx solid #d7e4dc;
  border-radius:18rpx;
  font-size:26rpx
}

.send-btn {
  display:flex;
  justify-content:center;
  align-items:center;
  min-width:102rpx;
  height:88rpx;
  padding:0 20rpx;
  background:var(--primary);
  border-radius:18rpx;
  color:#fff;
  font-size:29rpx
}

.send-btn.off {
  opacity:.5
}

.kinds {
  display:flex;
  flex-wrap:wrap;
  gap:14rpx;
  margin:16rpx 0
}

.kind {
  padding:15rpx 24rpx;
  border:1rpx solid #cdded3;
  border-radius:14rpx;
  font-size:26rpx;
  color:var(--ink-2)
}

.kind.active {
  background:var(--primary-soft);
  color:var(--primary);
  border-color:var(--primary)
}

.pending {
  display:flex;
  gap:12rpx;
  flex-wrap:wrap;
  margin-top:18rpx
}

.pending-item {
  position:relative
}

.pending-img {
  width:120rpx;
  height:120rpx;
  border-radius:14rpx
}

.pending-x {
  position:absolute;
  right:-8rpx;
  top:-8rpx;
  min-width:60rpx;
  min-height:60rpx;
  background:#fff;
  color:#233d34;
  border-radius:50%;
  text-align:center;
  font-size:35rpx
}

.recognition {
  font-size:27rpx;
  line-height:1.6;
  margin:16rpx 0
}

.recognition-warning {
  display:block;
  color:#8b481f
}

.card-preview {
  max-height:30vh;
  overflow-y:auto
}

.proposals {
  height:42vh
}

.proposal {
  padding:20rpx 0;
  border-bottom:1rpx solid #d7e4dc;
  font-size:29rpx
}

.char-count {
  display:block;
  text-align:right;
  font-size:25rpx;
  margin-top:12rpx
}







.voice-status {
  font-size:26rpx;
  color:var(--ink-2);
  display:block;
  margin:12rpx 0
}



.page button.home-search {
  display:block;
  width:100%;
  max-width:none;
  min-width:0;
  margin:8rpx 0 18rpx
}

.quick-links button.btn-text {
  width:auto;
  min-width:0;
  flex:1;
  padding:8rpx 4rpx
}



.tl-item { display:flex; align-items:stretch; }
.tl-time { width:82rpx; flex:none; padding:12rpx 12rpx 0 0; text-align:right; font-size:25rpx; line-height:1.5; color:var(--ink-2); font-variant-numeric:tabular-nums; }
.tl-time text { display:block; }
.tl-time-hint { font-size:20rpx; color:var(--ink-3); }
.tl-rail { width:28rpx; flex:none; position:relative; display:flex; justify-content:center; padding-top:26rpx; }
.tl-rail::before { content:''; position:absolute; top:0; bottom:0; width:2rpx; background:#cdded4; }
.tl-item:last-child .tl-rail::before { bottom:auto; height:28rpx; }
.tl-node { position:relative; width:14rpx; height:3rpx; background:#378574; }
.tl-node-health { background:#ad6570; }
.tl-node-first { background:#a56d2d; }
.tl-card { flex:1; min-width:0; padding-left:12rpx; padding-bottom:14rpx; }
.initial-placeholder { padding:16rpx 0; }
.initial-placeholder view { height:80rpx; margin-bottom:16rpx; border-radius:12rpx; background:#e7efea; }

.input-dock { padding:14rpx 24rpx; }
.input-dock .composer-row { margin-top:0; align-items:center; gap:10rpx; }
.input-dock button { margin:0; }
.input-dock button.mode-button { width:78rpx; min-width:0; padding:0; min-height:84rpx; background:transparent; color:#176d5d; font-size:24rpx; line-height:1.5; display:flex; align-items:center; justify-content:center; }
.input-dock button.speak-button { flex:1; width:auto; min-width:0; height:88rpx; padding:0 16rpx; border:1rpx solid #b7d1c1; border-radius:18rpx; background:#fff; color:#233d34; font-size:29rpx; display:flex; align-items:center; justify-content:center; }
.input-dock button.speak-button.recording { background:#d9eee2; border-color:#096f60; color:#075c4f; }
.input-dock button.add-button { width:72rpx; min-width:0; padding:0; height:84rpx; background:transparent; font-size:42rpx; line-height:84rpx; color:#176d5d; }
.input-dock button.send-button { width:96rpx; min-width:0; padding:0 8rpx; height:84rpx; line-height:84rpx; background:#096f60; color:#fff; font-size:27rpx; border-radius:16rpx; }
.input-dock .composer-input { width:100%; min-width:0; min-height:84rpx; max-height:200rpx; padding:14rpx 18rpx; }
.transcript { margin:10rpx 0; }
.draft-review { max-height:38vh; overflow-y:auto; margin-bottom:12rpx; }
.queue-line { font-size:25rpx; color:#176d5d; padding:8rpx 0 16rpx; }
.queue-error { display:block; font-size:24rpx; color:#8b481f; padding-bottom:12rpx; }
.duplicate-review { padding:18rpx; border:1rpx solid #d9be8f; border-radius:16rpx; background:#fffaf1; font-size:25rpx; }
.duplicate-text { display:block; white-space:pre-wrap; margin:10rpx 0; }
