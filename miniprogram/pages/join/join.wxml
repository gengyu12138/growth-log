<backdrop dense />
<navbar />

<view class="landing">
  <view class="brand">
    <view class="brand-rule"></view>
    <text class="brand-title rise">成长记录</text>
    <text class="brand-sub rise-2">和家人一起，留住长大的瞬间</text>
  </view>

  <view class="invite-card surface-lit rise-3">
    <view class="mode-tabs"><button class="btn-text" data-mode="join" bindtap="onMode">加入家人</button><button class="btn-text" data-mode="create" bindtap="onMode">创建家庭</button></view>
    <view class="card-head">
      <text class="card-title">{{mode === 'join' ? '加入家人的成长记录' : '创建自己的家庭空间'}}</text>
      <text class="card-sub">{{mode === 'join' ? '填写家人发来的六位邀请码' : '创建后可以邀请家人共同记录和回看'}}</text>
    </view>

    <view class="field">
      <text class="field-label">{{mode === 'join' ? '六位邀请码' : '家庭标识（可留空自动生成）'}}</text>
      <input
        class="field-input code-input"
        value="{{code}}"
        bindinput="onCode"
        maxlength="{{mode === 'join' ? 6 : 12}}"
        placeholder="{{mode === 'join' ? '请输入六位邀请码' : '选填，4–12 位字母或数字'}}"
        placeholder-class="ph"
        confirm-type="done"
        bindconfirm="onJoin"
      />
    </view>

    <view class="field">
      <text class="field-label">你的称呼</text>
      <input
        class="field-input"
        value="{{name}}"
        bindinput="onName"
        maxlength="12"
        placeholder="选填，如 奶奶"
        placeholder-class="ph"
      />
    </view>

    <button
      class="btn btn-primary submit"
      hover-class="btn-primary-hover"
      disabled="{{busy}}"
      bindtap="onJoin"
    >{{busy ? '正在处理…' : mode === 'join' ? '加入家庭' : '创建家庭'}}</button>

    <text class="msg-error">{{msg}}</text>
  </view>

</view>
