.page {
  position: relative;
  z-index: 1;
  padding: 8rpx 32rpx calc(80rpx + env(safe-area-inset-bottom));
}

.back-row {
  display: flex;
  align-items: center;
  height: 64rpx;
  margin-bottom: 4rpx;
}

.back-arrow {
  font-size: 34rpx;
  color: var(--ink-3);
  margin-right: 6rpx;
}

.back-text {
  font-size: 25rpx;
  color: var(--ink-3);
}

.head {
  padding: 20rpx 4rpx 40rpx;
}

.head-title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: var(--ink);
}

.head-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 0.8rpx;
}

/* ── 成员列表 ── */
.member-list {
  display: flex;
  flex-direction: column;
}

.member {
  display: flex;
  align-items: center;
  padding: 26rpx 26rpx;
  margin-bottom: 14rpx;
  transition: background-color 160ms ease;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: var(--r-sm);
  background: var(--card-3);
  color: var(--ink-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 22rpx;
}

.avatar-owner {
  background: var(--cinnabar);
  color: #ffffff;
}

.member-body {
  flex: 1;
  min-width: 0;
}

.member-line {
  display: flex;
  align-items: center;
}

.member-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
}

.member-me {
  margin-left: 12rpx;
  padding: 1rpx 10rpx;
  border: 1rpx solid var(--line-2);
  border-radius: 5rpx;
  font-size: 19rpx;
  color: var(--ink-3);
}

.member-role {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.8rpx;
}

.member-more {
  padding-left: 20rpx;
  font-size: 26rpx;
  letter-spacing: 3rpx;
  color: var(--ink-3);
}

/* ── 邀请 ── */
.invite-block {
  margin-top: 54rpx;
}

.section-head {
  padding: 0 4rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--ink);
}

.section-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.role-picker {
  display: flex;
  margin-bottom: 26rpx;
}

.role-option {
  flex: 1;
  padding: 22rpx 24rpx;
  margin-right: 16rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  transition: border-color 160ms ease, background-color 160ms ease;
}

.role-option:last-child {
  margin-right: 0;
}

.role-option.active {
  background: var(--cinnabar-soft);
  border-color: var(--primary-line);
}

.role-option-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.role-option.active .role-option-name {
  color: var(--cinnabar);
}

.role-option-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ── 邀请码结果 ── */
.invite-result {
  margin-top: 34rpx;
  padding: 38rpx 32rpx 26rpx;
  text-align: center;
}

.invite-code {
  display: block;
  margin: 22rpx 0 20rpx;
  padding-left: 16rpx;
  font-size: 66rpx;
  font-weight: 600;
  letter-spacing: 16rpx;
  color: var(--cinnabar);
  line-height: 1.2;
}

.invite-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  margin-top: 8rpx;
}

.profile { padding: 28rpx; margin-bottom: 32rpx; }
.profile .field-label { margin-top: 22rpx; }
.profile-date { display: flex; align-items: center; }
.profile .t-micro { display: block; margin: 20rpx 0; }

.page{padding-bottom:calc(160rpx + env(safe-area-inset-bottom))}

.settings-links{display:flex;flex-direction:column;gap:18rpx;margin-bottom:28rpx}.settings-links .btn{width:100%}
